{
  "name": "web-calculator",
  "version": "0.1.0",
  "description": "Web-based calculator with high precision decimal arithmetic",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext .js",
    "format": "prettier --write \"**/*.{js,json,html,css,md}\""
  },
  "keywords": [
    "calculator",
    "decimal",
    "precision",
    "arithmetic"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "decimal.js": "^10.4.3"
  },
  "devDependencies": {
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.55.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.1.1",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
